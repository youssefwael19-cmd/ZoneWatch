//@version=6
// ============================================================================
// Zone Watch — bot signals on the chart
//
// Draws every signal the Zone Watch app took (or held back) as an arrow with
// its stop and target, at the bar where the signal happened.
//
// WHY THE DATA IS PASTED AND NOT FETCHED
// Pine Script can only read TradingView's own market data: request.security()
// takes a symbol, not a URL, and there is no HTTP request function. So a
// TradingView script cannot call zonewatch.productecho.com. The signals are
// therefore carried in the text box below, which you refresh by running:
//
//     node scripts/make-pine-data.js
//
// and pasting what it prints into "Signals". The other direction does work:
// TradingView alerts can POST to the app (see /api/tv/webhook), because a
// webhook goes out from TradingView, not in.
//
// LINE FORMAT (the generator writes this, you should not have to type it)
//   epochMillis|SYMBOL|BUY|entry|stop|target|KIND
//   KIND is OPEN, WIN, LOSS, BE, EXPIRED or HELD.
//
// Times are absolute epoch milliseconds, so any timeframe works. A signal is
// drawn on the bar whose range contains it; on a daily chart several signals
// land on one bar and are drawn together.
// ============================================================================

indicator("Zone Watch — bot signals", overlay = true, max_labels_count = 500, max_lines_count = 500)

signalsInput = input.string("", title = "Signals (paste the generator's output)", display = display.none, confirm = false, tooltip = "node scripts/make-pine-data.js prints this block. One signal per line.")
chartOnly    = input.bool(true, "Only draw signals for this chart's symbol", tooltip = "A EURUSD signal drawn on a NASDAQ chart would sit at the wrong price, so this is on by default.")
showHeld     = input.bool(false, "Show held-back signals (never sent)", tooltip = "These were refused by a gate. They are what the app did NOT trade, so they are hidden by default.")
showLevels   = input.bool(true, "Draw the stop and target")
showTable    = input.bool(true, "Show the summary table")
buyColor     = input.color(#26a69a, "Buy")
sellColor    = input.color(#ef5350, "Sell")
heldColor    = input.color(color.new(color.gray, 20), "Held back")

// ---------------------------------------------------------------------------
// Parse once. The arrays live for the whole script run.
// ---------------------------------------------------------------------------
var array<float>  sigMs     = array.new_float()
var array<string> sigSymbol = array.new_string()
var array<string> sigSide   = array.new_string()
var array<float>  sigEntry  = array.new_float()
var array<float>  sigStop   = array.new_float()
var array<float>  sigTarget = array.new_float()
var array<string> sigKind   = array.new_string()
var bool          parsed    = false

if not parsed
    rows = str.split(signalsInput, "\n")
    for i = 0 to array.size(rows) - 1
        row = str.trim(array.get(rows, i))
        // The generator writes comments starting with '#', and blank lines are
        // common when pasting. Both are skipped rather than parsed as a signal.
        if row != "" and not str.startswith(row, "#")
            parts = str.split(row, "|")
            if array.size(parts) >= 7
                ms  = str.tonumber(array.get(parts, 0))
                ent = str.tonumber(array.get(parts, 3))
                sl  = str.tonumber(array.get(parts, 4))
                tp  = str.tonumber(array.get(parts, 5))
                if not na(ms) and not na(ent)
                    array.push(sigMs, ms)
                    array.push(sigSymbol, str.upper(array.get(parts, 1)))
                    array.push(sigSide, str.upper(array.get(parts, 2)))
                    array.push(sigEntry, ent)
                    array.push(sigStop, na(sl) ? ent : sl)
                    array.push(sigTarget, na(tp) ? ent : tp)
                    array.push(sigKind, str.upper(array.get(parts, 6)))
    parsed := true

forChart(sym) =>
    not chartOnly or str.contains(str.upper(syminfo.tickerid), sym)

// ---------------------------------------------------------------------------
// Draw. One pass per bar over the signal list.
// ---------------------------------------------------------------------------
var int buys   = 0
var int sells  = 0
var int wins   = 0
var int losses = 0
var int held   = 0

bool hitThisBar = false

if array.size(sigMs) > 0
    for i = 0 to array.size(sigMs) - 1
        t = array.get(sigMs, i)
        if t >= time and t < time_close
            sym  = array.get(sigSymbol, i)
            side = array.get(sigSide, i)
            kind = array.get(sigKind, i)
            ent  = array.get(sigEntry, i)
            sl   = array.get(sigStop, i)
            tp   = array.get(sigTarget, i)
            visible = forChart(sym) and (showHeld or kind != "HELD")
            if visible
                isBuy = side == "BUY"
                col   = kind == "HELD" ? heldColor : isBuy ? buyColor : sellColor
                hitThisBar := true
                if isBuy
                    buys += 1
                else
                    sells += 1
                if kind == "WIN"
                    wins += 1
                if kind == "LOSS"
                    losses += 1
                if kind == "HELD"
                    held += 1
                label.new(x = bar_index, y = ent, text = (isBuy ? "BUY " : "SELL ") + sym + "\n" + kind, xloc = xloc.bar_index, yloc = yloc.price, style = isBuy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small)
                if showLevels
                    line.new(x1 = bar_index, y1 = ent, x2 = bar_index + 4, y2 = sl, color = col, style = line.style_dashed, width = 1)
                    line.new(x1 = bar_index, y1 = ent, x2 = bar_index + 4, y2 = tp, color = col, style = line.style_dotted, width = 1)

// ---------------------------------------------------------------------------
// Summary, so the chart says what it is showing rather than just looking busy.
// A signal resolved with 0R (an expiry or a break-even) counts as neither a win
// nor a loss, which is the same rule the app's own stats use.
// ---------------------------------------------------------------------------
var table summary = table.new(position.top_right, 2, 6, border_width = 1)
if showTable and barstate.islast
    table.cell(summary, 0, 0, "Zone Watch", bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(summary, 1, 0, str.tostring(array.size(sigMs)) + " signals", bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(summary, 0, 1, "Buys", text_color = color.white, text_size = size.small)
    table.cell(summary, 1, 1, str.tostring(buys), text_color = buyColor, text_size = size.small)
    table.cell(summary, 0, 2, "Sells", text_color = color.white, text_size = size.small)
    table.cell(summary, 1, 2, str.tostring(sells), text_color = sellColor, text_size = size.small)
    table.cell(summary, 0, 3, "Won / lost", text_color = color.white, text_size = size.small)
    table.cell(summary, 1, 3, str.tostring(wins) + " / " + str.tostring(losses), text_color = color.white, text_size = size.small)
    table.cell(summary, 0, 4, "Held back", text_color = color.white, text_size = size.small)
    table.cell(summary, 1, 4, str.tostring(held), text_color = heldColor, text_size = size.small)
    table.cell(summary, 0, 5, "Chart", text_color = color.white, text_size = size.small)
    table.cell(summary, 1, 5, syminfo.tickerid, text_color = color.white, text_size = size.small)

// A real alert only makes sense for a signal that lands on the live bar, which
// requires the data to be refreshed while that bar is open. It is here so the
// condition exists, not because pasted history can fire it.
alertcondition(hitThisBar and barstate.islast, "Zone Watch signal on this bar", "A Zone Watch signal lands on the current bar")
